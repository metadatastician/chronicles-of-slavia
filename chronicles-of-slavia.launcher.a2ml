#
# chronicles-of-slavia.launcher.a2ml — per-app launcher config for Chronicles of Slavia.
# Compliant with launcher-standard.a2ml v0.3.0
#
# Chronicles of Slavia Prototype

[project]
name         = "chronicles-of-slavia"
display      = "Chronicles of Slavia"
description  = "Prototype game"
categories   = ["Game"]
version      = "0.1.0"
license      = "MPL-2.0"

[repo]
# NOTE: repo-dir is resolved at runtime from the launcher script location.
# Do NOT hardcode absolute paths. Leave empty or use relative paths.
path = ""

[runtime]
# Chronicles of Slavia is a process-based game
kind = "process"
startup-command-search = [
    "{repo-dir}/engine/target/release/slavia-zone-a",
    "{repo-dir}/engine/slavia-zone-a/target/release/slavia-zone-a",
    "slavia-zone-a",
]
# Per launcher-standard.a2ml [runtime] section:
# PID files MUST use XDG_RUNTIME_DIR or TMPDIR, NEVER /tmp directly
# Log files MUST use XDG_STATE_HOME, NEVER /tmp directly
pid-file = "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/chronicles-of-slavia.pid"
log-file = "${XDG_STATE_HOME:-$HOME/.local/state}/chronicles-of-slavia/game.log"
wait-for-url-timeout-seconds = 10

[version-output]
# Per launcher-standard.a2ml [version-output] section
first-line-format = "chronicles-of-slavia {version} ({build-sha-short}) [{platform}]"
example = "chronicles-of-slavia 0.1.0 (abc1234) [linux-x86_64]"
exit-code = 0

[icon]
source = "{repo-dir}/assets/icon-256.png"
