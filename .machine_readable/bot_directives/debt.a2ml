[metadata]
version = "1.0.0"
last-updated = "2026-08-07"
twin = "docs/status/DEBT.adoc"
method = "ground-truthed against the tree, not read off status docs"

# ============================================================================
# OWNER-ONLY — an agent must not action these
# ============================================================================
# Licence edits are manual and owner-only (doctrine 6). Registration and billing
# are outward-facing (doctrine 11). Recorded, deliberately untouched.

[[debt.owner]]
id = "LIC-1"
component = "README.adoc"
issue = "Two conflicting SPDX headers: AGPL-3.0-or-later (line 1) and CC-BY-SA-4.0 (line 2). A file has one licence. ADR-0008 makes prose CC-BY-SA-4.0, which suggests line 1 is the stray — but deleting either is a licensing decision."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.owner]]
id = "LIC-2"
component = "chronicles-of-slavia.launcher.a2ml"
issue = "Declares license = MPL-2.0, contradicting ADR-0008 (AGPL-3.0-or-later). Same file declares version = 0.1.0 while both crates are 0.0.0."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.owner]]
id = "LIC-3"
component = ".machine_readable/descriptiles/AGENTIC.a2ml + CLAUDE.md"
issue = "Both say 'Never use AGPL' while ADR-0008 rules AGPL-3.0-or-later for this repo's code. The estate policy is per-repo overridable via AGENTIC, but the override is unrecorded — so the substrate an agent reads on arrival contradicts the merged ADR. Rhodibot's canary was aligned in #58; the descriptiles were not."
effort = "easy"
impact = "high"
discovered = "2026-08-07"

[[debt.owner]]
id = "CAN-3"
component = "docs/design/24 + 25"
issue = "Zone B's 8 rulings outstanding (issue #63). Zone B cannot be scoped and doc 24 stays provisional until they land."
effort = "medium"
impact = "medium"
discovered = "2026-08-04"

[[debt.owner]]
id = "CI-8"
component = ".github/dependabot.yml"
issue = "Five Dependabot runs queued 22h+ (nix, github_actions, npm_and_yarn, hex, pip). Config is valid; the runner pool is stalled — may need an org spending-limit check. Separately, most of those ecosystems are template residue and do not apply to a Rust project."
effort = "easy"
impact = "medium"
discovered = "2026-08-04"

[[debt.owner]]
